# ArgusAI — environment variable template
# Copy to .env and fill in your values before running locally.
#
# ===================================================================
# DATABASE ARCHITECTURE
# ===================================================================
#
# Local development:
#   SQLite file at ./backend/app.db (default, zero config).
#   Set DATABASE_URL=sqlite:///./backend/app.db or leave unset.
#
# Production (Modal):
#   modal_app.py mounts a modal.Volume at /data. When no DATABASE_URL
#   is set, the app falls back to sqlite:////data/argusai.db on that
#   volume - this persists across cold starts and works with a single
#   container (max_containers=1).
#
#   To scale beyond one container, switch to cloud Postgres:
#     Neon:     DATABASE_URL=postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
#     Supabase: DATABASE_URL=postgresql://<user>:<pass>@<host>.supabase.co:5432/<db>
#   Store in Modal Secrets:
#     modal secret create argusai-secrets DATABASE_URL="postgresql://..."
#
# ===================================================================

# -------------------------------------------------------------------
# Required
# -------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# -------------------------------------------------------------------
# Optional — observability
# -------------------------------------------------------------------

# Pydantic Logfire token; leave blank to disable telemetry
LOGFIRE_TOKEN=

# -------------------------------------------------------------------
# Optional — overrides (defaults shown)
# -------------------------------------------------------------------

# Comma-separated list of allowed CORS origins.
# Local dev defaults to localhost:5173. Add your Vercel production
# URL when deploying (e.g. https://argusxai.vercel.app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://argusxai.vercel.app

# Database connection string.
# Local: SQLite (default). Production: cloud Postgres (see above).
DATABASE_URL=sqlite:///./backend/app.db

# Gemini Live (voice) model ID
GEMINI_LIVE_MODEL=gemini-3.8-live

# Gemini Vision model ID
GEMINI_VISION_MODEL=gemini-3.6-flash

# ===================================================================
# MODAL SECRETS SETUP (production)
# ===================================================================
# Create the secret once — Modal injects these as env vars at runtime:
#
#   modal secret create argusai-secrets \
#     GEMINI_API_KEY="your-key" \
#     CORS_ORIGINS="http://localhost:5173,https://argusxai.vercel.app" \
#     LOGFIRE_TOKEN="optional-token"
#
# For local Modal dev using your .env file instead:
#   export ARGUSAI_MODAL_SECRET_MODE=dotenv
#   modal serve backend/modal_app.py
# ===================================================================
