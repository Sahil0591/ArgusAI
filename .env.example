# ArgusAI — environment variable template
# Copy to .env and fill in your values before running locally.

# -------------------------------------------------------------------
# Required
# -------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------

# Local dev: SQLite (default, zero config — leave unset or use below).
DATABASE_URL=sqlite:///./backend/app.db

# Production (Supabase free tier):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Get this from: Supabase project → Settings → Database → Connection string → URI

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------

# Comma-separated allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://argusxai.vercel.app

# -------------------------------------------------------------------
# Model overrides (defaults shown)
# -------------------------------------------------------------------

GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.6-flash

# -------------------------------------------------------------------
# Optional — observability (Logfire free tier)
# -------------------------------------------------------------------

LOGFIRE_TOKEN=
