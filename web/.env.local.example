# ArgusAI Next.js frontend — local development template.
# Copy to web/.env.local. Do NOT commit web/.env.local.
#
# ===================================================================
# VERCEL DEPLOYMENT
# ===================================================================
# In the Vercel dashboard (Settings > Environment Variables), set:
#
#   NEXT_PUBLIC_API_BASE = https://<modal-workspace>--argusai-web.modal.run
#
# This is the only variable the frontend needs.
# ===================================================================

# --- Local dev: point at the local FastAPI server ---
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Or point local frontend at deployed Modal backend ---
# NEXT_PUBLIC_API_BASE=https://<modal-workspace>--argusai-web.modal.run
