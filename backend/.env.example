# ArgusAI backend local development template.
# Copy to backend/.env. Do not commit backend/.env.

# Local default: SQLite file at ./backend/app.db.
# For local Postgres, use:
# DATABASE_URL=postgresql+psycopg://argusai:password@localhost:5432/argusai
DATABASE_URL=sqlite:///./backend/app.db

# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call the backend.
# Add your Vercel production origin in Modal Secrets, for example:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://argusai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional observability.
LOGFIRE_TOKEN=

# Model overrides.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.6-flash
